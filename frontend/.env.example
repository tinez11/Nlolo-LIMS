# Copy to .env.local for local development.

# Where the SPA sends API calls. In dev this is the Vite proxy path, which keeps the
# browser same-origin: the backend has NO CORS configuration, so a direct
# cross-origin call to :8080 is blocked by the browser outright.
#
# The specs declare `servers: [https://api.nlolo-lifeplatform.tz/v1]`, but the app
# sets no server.servlet.context-path and serves at the root -- so /v1 is a
# deployment concern, never a code assumption.
VITE_API_BASE_URL=/api

# Where the dev proxy forwards to.
VITE_PROXY_TARGET=http://localhost:8080

# Keycloak. One issuer per realm; the SPA picks one from the realm-scoped route it
# is mounted under. `lifeplatform-spa` is the PUBLIC PKCE client -- the pre-existing
# `lifeplatform-app` is confidential and unusable from a browser.
VITE_KEYCLOAK_BASE_URL=http://localhost:8081
VITE_KEYCLOAK_CLIENT_ID=lifeplatform-spa
