target/
backend/.mvn/wrapper/maven-wrapper.jar
*.iml
.idea/
.vscode/
*.log
.env
.worktrees/

# Generated by scripts/seed-dev-data.sh at runtime (a throwaway JPEG for claim-evidence upload)
# -- not source, and regenerated identically on every run.
backend/scripts/seed-evidence.jpg

# Superpowers subagent-driven-development scratch (ledger, briefs, review packages).
# Git-ignored by design: the git history is the durable record, not these artifacts.
.superpowers/

# Claude Code per-machine settings. `.claude/settings.json` is shared config and
# SHOULD be committed when one exists; `settings.local.json` is one developer's
# machine — absolute paths into their own editor install, local worktree paths,
# process ids, and dev credentials in permission rules. Never shared.
.claude/settings.local.json

# A locally-created symlink mirror of .agents/skills, pointing at an ABSOLUTE path in
# whoever ran the installer's checkout. The canonical copy is committed under
# .agents/skills/ -- which is the path skills-lock.json records -- so this is
# regenerable and would only break for anyone else.
.claude/skills/

# Frontend (M12)
node_modules/
frontend/**/.next/
frontend/**/out/
frontend/**/.env.local
frontend/**/coverage/
frontend/**/test-results/
frontend/**/playwright-report/
