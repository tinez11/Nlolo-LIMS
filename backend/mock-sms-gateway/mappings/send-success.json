{
  "request": {
    "method": "POST",
    "urlPath": "/send",
    "bodyPatterns": [{ "matchesJsonPath": "$.to" }]
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {
      "status": "ACCEPTED",
