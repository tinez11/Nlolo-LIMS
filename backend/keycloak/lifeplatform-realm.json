  "eventsListeners": [
    "jboss-logging",
    "email",
    "lifeplatform-password-changed"
  ],
  "eventsExpiration": 7776000,
  "eventsEnabled": true,
  "actionTokenGeneratedByUserLifespan": 900,
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
