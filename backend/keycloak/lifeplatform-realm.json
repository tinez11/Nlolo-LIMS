  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "staff",
        "description": "Insurer staff: the staff console. Job roles apply only here."
      },
      {
        "name": "agent",
        "description": "Agents: the agent console."
      },
      {
        "name": "customer",
        "description": "Policyholders: the customer portal."
      },
      {
        "name": "regulator",
        "description": "Regulators: regulatory returns."
      },
      {
        "name": "UNDERWRITER"
      },
      {
        "name": "SENIOR_UNDERWRITER",
        "description": "May decide an underwriting case against the rules engine's recommendation. Additive to UNDERWRITER, never a replacement: the decision endpoint is gated on UNDERWRITER, and this only lifts the bar on overriding."
      },
      {
        "name": "CLAIMS_ASSESSOR"
      },
      {
        "name": "CLAIMS_MANAGER"
      },
      {
        "name": "FINANCE_OFFICER"
      },
      {
        "name": "FINANCE_APPROVER",
        "description": "IFRS 17 I4: approves or rejects a manual journal prepared by someone else. Additive to FINANCE_OFFICER; given to finance managers."
      },
      {
        "name": "CUSTOMER_SERVICE_REP"
      },
      {
        "name": "ADMIN"
      },
      {
        "name": "TIRA_READ_ONLY"
