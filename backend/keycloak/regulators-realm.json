{
  "realm": "regulators",
  "displayName": "Regulator access",
  "loginTheme": "lifeplatform",
  "emailTheme": "lifeplatform",
  "maxFailureWaitSeconds": 900,
  "waitIncrementSeconds": 60,
  "failureFactor": 5,
  "permanentLockout": false,
  "bruteForceProtected": true,
  "passwordPolicy": "length(10) and notUsername(undefined) and notEmail(undefined) and passwordHistory(3)",
  "defaultLocale": "en",
  "supportedLocales": ["en","sw"],
  "internationalizationEnabled": true,
  "adminEventsDetailsEnabled": false,
  "adminEventsEnabled": true,
  "enabledEventTypes": ["LOGIN","LOGIN_ERROR","LOGOUT","SEND_RESET_PASSWORD","SEND_RESET_PASSWORD_ERROR","RESET_PASSWORD","RESET_PASSWORD_ERROR","UPDATE_PASSWORD","UPDATE_PASSWORD_ERROR","UPDATE_CREDENTIAL","UPDATE_CREDENTIAL_ERROR","EXECUTE_ACTIONS","EXECUTE_ACTION_TOKEN","EXECUTE_ACTION_TOKEN_ERROR","UPDATE_EMAIL","USER_DISABLED_BY_TEMPORARY_LOCKOUT"],
  "eventsListeners": ["jboss-logging","email"],
  "eventsExpiration": 7776000,
  "eventsEnabled": true,
  "actionTokenGeneratedByUserLifespan": 900,
  "resetPasswordAllowed": true,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@nlolo.local",
    "fromDisplayName": "Nlolo Life"
  },
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      { "name": "TIRA_READ_ONLY" }
    ]
  },
  "clients": [
    {
      "clientId": "lifeplatform-app",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:3000/*", "http://localhost:8080/*"],
      "webOrigins": ["http://localhost:3000"],
      "secret": "dev-secret-regulators",
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "regulator.tira",
      "enabled": true,
      "emailVerified": true,
      "email": "regulator.tira@example.tz",
      "firstName": "Salum",
      "lastName": "Tira",
      "attributes": { "tenant_id": ["11111111-1111-1111-1111-111111111111"] },
      "credentials": [{ "type": "password", "value": "devpassword", "temporary": false }],
      "realmRoles": ["TIRA_READ_ONLY"]
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"email\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"firstName\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"lastName\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false}],\"groups\":[],\"unmanagedAttributePolicy\":\"ADMIN_EDIT\"}"
          ]
        }
      }
    ]
  }
}
