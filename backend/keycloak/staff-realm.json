{
  "realm": "staff",
  "displayName": "Staff console",
  "loginTheme": "lifeplatform",
  "emailTheme": "lifeplatform",
  "maxFailureWaitSeconds": 900,
  "waitIncrementSeconds": 60,
  "failureFactor": 5,
  "permanentLockout": false,
  "bruteForceProtected": true,
  "passwordPolicy": "length(8) and notUsername(undefined) and notEmail(undefined) and passwordHistory(3)",
  "defaultLocale": "en",
  "supportedLocales": ["en","sw"],
  "internationalizationEnabled": true,
  "adminEventsDetailsEnabled": false,
  "adminEventsEnabled": true,
  "enabledEventTypes": ["LOGIN","LOGIN_ERROR","LOGOUT","SEND_RESET_PASSWORD","SEND_RESET_PASSWORD_ERROR","RESET_PASSWORD","RESET_PASSWORD_ERROR","UPDATE_PASSWORD","UPDATE_PASSWORD_ERROR","UPDATE_CREDENTIAL","UPDATE_CREDENTIAL_ERROR","EXECUTE_ACTIONS","EXECUTE_ACTION_TOKEN","EXECUTE_ACTION_TOKEN_ERROR","UPDATE_EMAIL","USER_DISABLED_BY_TEMPORARY_LOCKOUT"],
  "eventsListeners": ["jboss-logging","email"],
  "eventsExpiration": 7776000,
  "eventsEnabled": true,
  "actionTokenGeneratedByUserLifespan": 900,
  "resetPasswordAllowed": true,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@nlolo.local",
    "fromDisplayName": "Nlolo Life"
  },
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "UNDERWRITER"
      },
      {
        "name": "SENIOR_UNDERWRITER",
        "description": "May decide an underwriting case against the rules engine's recommendation. Additive to UNDERWRITER, never a replacement: the decision endpoint is gated on UNDERWRITER, and this only lifts the bar on overriding."
      },
      {
        "name": "CLAIMS_ASSESSOR"
      },
      {
        "name": "CLAIMS_MANAGER"
      },
      {
        "name": "FINANCE_OFFICER"
      },
      {
        "name": "FINANCE_APPROVER",
        "description": "IFRS 17 I4: approves or rejects a manual journal prepared by someone else. Additive to FINANCE_OFFICER; given to finance managers."
      },
      {
        "name": "CUSTOMER_SERVICE_REP"
      },
      {
        "name": "ADMIN"
      }
    ]
  },
  "clients": [
    {
      "clientId": "lifeplatform-app",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:8080/*"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "secret": "dev-secret-staff",
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "home_branch",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "home_branch",
            "claim.name": "home_branch",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "lifeplatform-spa",
      "name": "Life Platform SPA (browser, PKCE)",
      "description": "Public client for the browser SPA at frontend/. A browser cannot hold a secret, so this is publicClient with PKCE S256 required; lifeplatform-app stays confidential for backend/service use.",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "home_branch",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "home_branch",
            "claim.name": "home_branch",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "lifeplatform-staff-admin",
      "name": "Life Platform staff user admin (service account)",
      "description": "The backend adds, closes and resets staff logins through this service account (manage-users in this realm only) when an administrator uses the Users screen. No browser flows. Roles are not written here: the platform holds them.",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "dev-secret-staff-admin"
    }
  ],
