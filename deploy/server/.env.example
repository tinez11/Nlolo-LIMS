# The server's settings (2026-10-13). bootstrap-server.sh copies this to .env and fills every secret; you edit the
# rest. NEVER commit the filled .env -- it is the whole platform's keys in one file.
#
# QUOTE ANY VALUE CONTAINING A SPACE. The release scripts source this file, so an unquoted `Basic abc123` runs
# `abc123` as a command and the release dies somewhere unrelated. Docker Compose strips the quotes too, so quoting
# is always safe.

# --- what is deployed (remote-release.sh rewrites RELEASE; do not edit by hand) ---
RELEASE=
IMAGE_PREFIX=ghcr.io/OWNER/platform

# --- names. Change these to rename, then move DNS and release again. Nothing else spells a hostname out. ---
APP_DOMAIN=app.example.co.tz
AUTH_DOMAIN=auth.example.co.tz
ACME_EMAIL=ops@example.co.tz
# Empty in production, where Let's Encrypt issues the certificates. "local_certs" for the dress rehearsal, where
# Caddy signs with a CA of its own.
CADDY_GLOBAL_OPTIONS=
# Rehearsal only: makes the backend trust that CA. Unset in production.
EXTRA_CA_FILE=

# --- the one tenant every user carries (a UUID; bootstrap-server.sh generates it) ---
PLATFORM_TENANT_ID=

# --- databases ---
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KC_ADMIN_PASSWORD=

# --- documents (SeaweedFS speaks S3; see versions.env for why it is not MinIO) ---
OBJECT_STORE_ACCESS_KEY=platform-docs
OBJECT_STORE_SECRET_KEY=

# --- integrations ---
PORTAL_ADMIN_CLIENT_SECRET=
MOBILE_MONEY_CALLBACK_HMAC_SECRET=
SMS_GATEWAY_BASE_URL=https://messaging-service.co.tz
SMS_GATEWAY_AUTHORIZATION=""
SMS_GATEWAY_SENDER_NAME=AMC
SMS_GATEWAY_LIVE=true
# Comma-separated 255... numbers (no plus) during the pilot, so a stray notification cannot text a real customer.
# Empty means EVERY recipient is delivered to: set that only when real customers are onboarding.
SMS_GATEWAY_ALLOWED_RECIPIENTS=

# --- email: off until a provider account and the domain's SPF/DKIM records exist ---
# With it false, portal invites go by SMS, Keycloak's self-service password reset is off, and email notifications are
# recorded as FAILED saying so rather than attempted. Turning it on needs no code change -- fill these and release.
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.co.tz
MAIL_FROM_NAME="Life Platform"

# --- off-server backups (any S3-compatible store, e.g. Backblaze B2) ---
# Empty keeps backups ON THE SERVER ONLY, which protects against a bad release and not against losing the server.
# backup.sh warns every night while this is empty.
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_BUCKET=

# --- the first staff login, created once on the first release ---
FIRST_ADMIN_HOME_BRANCH=DSM
