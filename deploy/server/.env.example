# The server's settings (2026-10-13). bootstrap-server.sh copies this to .env and fills every secret; you edit the
# rest. NEVER commit the filled .env -- it is the whole platform's keys in one file.
#
# QUOTE ANY VALUE CONTAINING A SPACE. The release scripts source this file, so an unquoted `Basic abc123` runs
# `abc123` as a command and the release dies somewhere unrelated.
#
# The services never read this file themselves (2026-11-20, native under systemd): each release writes each service
# only its own settings, in /etc/platform. Edit here, then release (or ./remote-release.sh the current version).

# --- names. Change these to rename, then move DNS and release again. Nothing else spells a hostname out. ---
APP_DOMAIN=app.example.co.tz
AUTH_DOMAIN=auth.example.co.tz
ACME_EMAIL=ops@example.co.tz
# Empty in production, where Let's Encrypt issues the certificates.
CADDY_GLOBAL_OPTIONS=
# Office addresses that skip the sign-in and console rate limits (2026-11-23), space-separated, e.g.
# "196.41.0.10 41.59.12.0/28". Never the public pages. Empty: nobody is exempt.
RATE_LIMIT_EXEMPT=

# --- the one tenant every user carries (a UUID; bootstrap-server.sh generates it) ---
PLATFORM_TENANT_ID=

# --- databases ---
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
AUTHENTIK_DB_PASSWORD=

# --- sign-in: Authentik (2026-11-20). bootstrap-server.sh generates every one of these. ---
# Authentik's own key for sessions and signing cookies. Changing it signs everyone out.
AUTHENTIK_SECRET_KEY=
# The administrator akadmin's password, read on Authentik's first boot only (DEPLOYMENT-GUIDE.md, "The Authentik admin").
AUTHENTIK_BOOTSTRAP_PASSWORD=
# The backend's API token: the blueprint gives Authentik's lifeplatform-backend account this key, and the backend sends
# it. One value, read by both.
AUTHENTIK_API_TOKEN=
# Bearer secrets on Authentik's calls into the backend: the staff sign-in code, and "your password was changed".
SIGN_IN_CODE_WEBHOOK_SECRET=
PASSWORD_CHANGED_WEBHOOK_SECRET=

# --- documents (SeaweedFS speaks S3; see versions.env for why it is not MinIO) ---
OBJECT_STORE_ACCESS_KEY=platform-docs
OBJECT_STORE_SECRET_KEY=

# --- integrations ---
MOBILE_MONEY_CALLBACK_HMAC_SECRET=
# The reset page (/reset), where agents and customers reset a forgotten password, and the public quote link. Both
# check visitors with Cloudflare Turnstile: the widget's SECRET key here, its site key in deploy/release.env
# (Cloudflare dashboard > Turnstile > Add widget, hostname = APP_DOMAIN, Managed mode). The backend refuses to start
# with a test key or none. The visit secret signs each visitor's session; bootstrap-server.sh generates it.
TURNSTILE_SECRET=
PUBLIC_VISIT_SECRET=
# The public quote link (/quote): off until the insurer wants it.
PUBLIC_QUOTE_ENABLED=false
# The number "your password was changed -- if this wasn't you, call ..." gives (2026-11-06). Required.
SUPPORT_PHONE=
# Who the watcher texts when something on this server breaks, clears or stays broken (2026-11-23, watch.sh): one or two
# on-call mobiles, +255..., in quotes, space- or comma-separated. Required: a release refuses to run without it.
ALERT_PHONES=
# A texted code after the password on every staff sign-in (2026-11-14). The backend refuses to start with it off, and
# every active staff login needs a phone first (Users and roles lists those without).
STAFF_SIGN_IN_CODE=true
SMS_GATEWAY_BASE_URL=https://messaging-service.co.tz
SMS_GATEWAY_AUTHORIZATION=""
SMS_GATEWAY_SENDER_NAME=AMC
SMS_GATEWAY_LIVE=true
# Comma-separated 255... numbers (no plus) during the pilot, so a stray notification cannot text a real customer.
# Empty means EVERY recipient is delivered to: set that only when real customers are onboarding.
SMS_GATEWAY_ALLOWED_RECIPIENTS=

# --- email: off until a provider account and the domain's SPF/DKIM records exist ---
# With it false, portal invites go by SMS, "Forgot your password?" texts a code (agents and customers, at /reset; staff
# are reset by an administrator), and nothing shows email as a channel. Turning it on needs no code change -- fill these, release.
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.co.tz
MAIL_FROM_NAME="Life Platform"

# --- off-server backups (any S3-compatible store, e.g. Backblaze B2) ---
# Empty keeps backups ON THE SERVER ONLY, which protects against a bad release and not against losing the server.
# backup.sh warns every night while this is empty.
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_BUCKET=
# Encrypts every off-server copy (2026-11-16); bootstrap-server.sh generates it. KEEP A COPY OFF THIS SERVER: if the
# server is lost, its .env goes with it, and without this password no off-server backup can be read.
BACKUP_CRYPT_PASSWORD=

# --- the first staff login, created once on the first release ---
FIRST_ADMIN_HOME_BRANCH=DSM
# Required: the first administrator's sign-in code is texted here (2026-11-14), e.g. +255712345678.
FIRST_ADMIN_PHONE=
