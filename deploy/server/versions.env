# Every third-party image the server runs, pinned to an exact tag (2026-10-13). Read by compose (--env-file) and by
# the release scripts. No ":latest" anywhere under deploy/: a release has to be the same thing twice, and an image
# that moves under a rolling tag makes a rollback a guess.
#
# Change a version here and release again; nothing else names these tags.

KEYCLOAK_VERSION=26.0.7
# Its suffix must match the Keycloak minor above -- the admin API it writes to changes between them.
KC_CONFIG_CLI_VERSION=6.2.1-26.0.5
FLYWAY_VERSION=10.20.1
CADDY_VERSION=2.11.7-alpine

# SeaweedFS, not MinIO: MinIO withdrew public distribution in 2025 (Docker Hub repositories removed, dl.min.io 410,
# quay.io authenticated), so no new server can pull it. The platform asks the store only for putObject and getObject
# through the io.minio SDK, which is an S3 client -- ObjectStoreCompatibilityTest proves this image answers both.
SEAWEEDFS_VERSION=3.80

WIREMOCK_VERSION=3.5.4
RCLONE_VERSION=1.68.2
NODE_VERSION=22.12.0-alpine
TEMURIN_VERSION=21-jre-alpine
