# Every third-party program the server runs or builds with, pinned to an exact version (2026-10-13; native under
# systemd since 2026-11-20, ticket 10 of .scratch/authentik-cutover). Read by bootstrap-server.sh, install-authentik.sh
# and the release scripts. Nothing "latest" anywhere: a release has to be the same thing twice, and a version that
# moves under you makes a rollback a guess.
#
# Change a version here and release again (bootstrap-server.sh for the system packages); nothing else names these.

# --- sign-in: Authentik, built from source on the server (install-authentik.sh) ---
# The blueprint and its CSS are written against this version; read the release notes before moving it. The build
# tools below are the ones upstream's own Dockerfile names at this tag (lifecycle/container/Dockerfile): change them
# together with it.
AUTHENTIK_VERSION=2026.8.5
AUTHENTIK_PYTHON_VERSION=3.14.7
AUTHENTIK_UV_VERSION=0.13.4
AUTHENTIK_NODE_VERSION=26.13.1
AUTHENTIK_PNPM_VERSION=11.20.0
# The Rust toolchain is read from the tag's own rust-toolchain.toml.

# --- the platform's own services ---
POSTGRES_MAJOR=16
FLYWAY_VERSION=10.20.1
# SeaweedFS, not MinIO: MinIO withdrew public distribution in 2025, so no new server can install it. The platform asks
# the store only for putObject and getObject through the io.minio SDK, an S3 client -- ObjectStoreCompatibilityTest
# proves SeaweedFS answers both.
SEAWEEDFS_VERSION=3.80
WIREMOCK_VERSION=3.5.4
RCLONE_VERSION=1.68.2
