# The documents: policy documents, KYC evidence, underwriting and claim evidence (2026-11-20, native; a container
# until then). SeaweedFS speaks S3, which is all the platform asks of it. Kept on this server rather than in someone
# else's cloud: these buckets hold scanned national IDs and death certificates.
#
# Its volume server moves to 8085: SeaweedFS's default, 8080, is the backend's.
[Unit]
Description=SeaweedFS object store (documents)
After=network-online.target
Wants=network-online.target

[Service]
User=seaweedfs
Group=seaweedfs
ExecStart=/usr/local/bin/weed server -ip=127.0.0.1 -ip.bind=127.0.0.1 -dir=/var/lib/seaweedfs \
  -master.port=9333 -volume.port=8085 -filer -filer.port=8888 \
  -s3 -s3.port=8333 -s3.config=/etc/platform/seaweedfs-s3.json
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/seaweedfs

[Install]
WantedBy=multi-user.target
