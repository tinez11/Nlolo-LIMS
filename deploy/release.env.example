# Local release settings. Copy to deploy/release.env, which is gitignored. No secrets belong here -- the server's
# .env holds those.

# The server, as the deploy user that bootstrap-server.sh created.
DEPLOY_HOST=deploy@203.0.113.10

# Must equal the server .env's AUTH_DOMAIN: it is compiled into the console at build time.
AUTH_DOMAIN=auth.example.co.tz

# Cloudflare Turnstile's SITE key (public, not a secret) for the console's address: Cloudflare dashboard > Turnstile >
# Add widget, hostname = APP_DOMAIN, Managed mode. Compiled into the console: the reset page checks visitors with it.
# Its secret half goes in the server .env as TURNSTILE_SECRET.
TURNSTILE_SITE_KEY=
