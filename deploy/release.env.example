# Local release settings. Copy to deploy/release.env, which is gitignored. No secrets belong here -- the server's
# .env holds those, and `docker login` holds the registry credential.

DEPLOY_HOST=deploy@203.0.113.10

# "remote" ships to DEPLOY_HOST. "local" is the dress rehearsal: the server side runs in deploy/.rehearsal on this
# machine, nothing is pushed and no SSH happens.
DEPLOY_MODE=remote

IMAGE_PREFIX=ghcr.io/OWNER/platform

# Must equal the server .env's AUTH_DOMAIN: it is compiled into the console at build time.
AUTH_DOMAIN=auth.example.co.tz
