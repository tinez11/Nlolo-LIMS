# The public front door (2026-10-13, deployment pilot §2). Both site addresses are settings: the names may change,
# so nothing here spells one out.
{
	{$CADDY_GLOBAL_OPTIONS}
	email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		# What the console may load (2026-11-16, security audit M1). Tokens live in memory, so injected script is the
		# way left to steal one; this is the second line against it. Scripts only from this origin (index.html has no
		# inline script -- its two boot scripts are files in public/) and Cloudflare Turnstile, which the public quote
		# link uses when it is on. Styles allow inline: React's style={{}} attributes need it, and a style cannot run.
		# Calls go to this origin and to the sign-in server; documents open from blob: URLs, PDFs in an <object>.
		Content-Security-Policy "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://{$AUTH_DOMAIN}; frame-src 'self' blob: https://{$AUTH_DOMAIN} https://challenges.cloudflare.com; object-src 'self' blob:; worker-src 'self' blob:; base-uri 'self'; form-action 'self' https://{$AUTH_DOMAIN}; frame-ancestors 'none'"
		# Nothing in the console uses the camera, microphone, location or payment request; no page it loads may either.
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
	}

	# The console calls /api on its own origin and the prefix is stripped here -- exactly what the Vite dev proxy
	# does, so dev and production differ in no way the code can see. One origin also means no CORS: the backend has
	# never had a CORS configuration, and this is why it does not need one.
	# Keycloak's calls into the platform (2026-10-28: texting a reset code) come over the private network. Signed as
	# they are, they have no business arriving from outside.
	# A handle, not a bare respond: Caddy runs handle before handle_path, and a bare respond after it, where it would
	# never be reached.
	handle /api/internal/* {
		respond 404
	}

	handle_path /api/* {
		reverse_proxy backend:8080
	}

	handle {
		root * /srv
		# A single-page app: every unknown path is a route inside it, not a missing file. index.html itself must not
		# be cached, or a release leaves browsers loading the previous build's asset names.
		@html path / /index.html
		header @html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

{$AUTH_DOMAIN} {
	# The admin console is reached through an SSH tunnel (deploy/README.md), never from the internet: it is the one
	# door where a stolen password owns every realm, and it has no business being on a public address.
	@admin path /admin /admin/*
	respond @admin 404

	# Keycloak's own `master` realm -- the Keycloak administrator's login -- shut too (2026-11-14, security audit H1).
	# Moving the console off the public address left master's token endpoint on it, where anyone could guess the
	# administrator's password as fast as the network allows, and one right guess owns every account. Nothing on the
	# internet needs master: the console comes through the SSH tunnel, and kcadm and keycloak-config reach Keycloak on
	# the private network. Staff, agents and customers sign in through `lifeplatform`, untouched.
	@master path /realms/master /realms/master/*
	respond @master 404

	reverse_proxy keycloak:8080
}
